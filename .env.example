# Sem credenciais: dados de exemplo reais, armazenamento local e limites em memória.
# Em produção, configure Postgres e Redis. A API falha fechada sem Redis.
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternativa nativa do Marketplace Vercel (Upstash for Redis):
KV_REST_API_URL=
KV_REST_API_TOKEN=
MCP_ENABLED=false
MCP_API_KEY=
# Cada instância local possui limites próprios; não usar em produção distribuída.
API_RATE_LIMIT=30
API_DAILY_LIMIT=5000
# Tetos próprios do projeto, não cotas oficiais da BrasilAPI. Apenas consultas sem cache.
BRASILAPI_ENABLED=true
BRASILAPI_DAILY_LIMIT=100
BRASILAPI_MIN_INTERVAL_SECONDS=15
# Apenas Vercel: confia em x-vercel-forwarded-for. Fora da Vercel usa um limite compartilhado.

# Opcionais. Analytics remove CNPJ e query string das URLs coletadas.
SENTRY_DSN=
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false
